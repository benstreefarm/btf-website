---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
---

<Layout title="Our Trees - Ben's Christmas Tree Farm">
    <Navigation />

    <div class="background-overlay">
        <img
            src="/DJI_0850sm.jpg"
            alt="Ben's Christmas Tree Farm"
            class="bg-image"
        />
    </div>

    <main class="content-container">
        <div class="glass-box">
            <h1>Our Tree Varieties</h1>
            <p class="intro-text">
                We specialize in 8 varieties of trees, carefully cultivated on
                our 100-acre farm in Harvard, IL. Each variety is hand-pruned to
                ensure the perfect shape. Here are our featured varieties, available up to 12+ feet tall:
            </p>

            <div class="tree-grid">
                <div class="tree-card">
                    <h3>Fraser Fir</h3>
                    <p>
                        Known as the "King of Trees," Fraser Firs offer
                        excellent needle retention and a pleasant scent.
                    </p>
                </div>

                <div class="tree-card">
                    <h3>Balsam Fir</h3>
                    <p>
                        A classic favorite with dark green needles and the
                        strongest "Christmas tree" fragrance.
                    </p>
                </div>

                <div class="tree-card">
                    <h3>Canaan Fir</h3>
                    <p>
                        A beautiful hybrid that combines the best traits of
                        Fraser and Balsam firs.
                    </p>
                </div>

                <!-- You can add the remaining 5 varieties here -->
            </div>
            <div class="complete-list-section">
                <h3>Complete list of varieties:</h3>
                <ul class="variety-list">
                    <li>Fraser Fir</li>
                    <li>Canaan Fir</li>
                    <li>Balsam Fir</li>
                    <li>Concolor Fir</li>
                    <li>Norway Spruce</li>
                    <li>Blue Spruce</li>
                    <li>Scotch Pine</li>
                    <li>White Pine</li>
                </ul>
            </div>
            <div class="cta-section">
                <p>Our trees are certified naturally grown! No herbicides or pesticides are ever used on our farm. </p>
                <!-- <a href="/contact" class="cta-button">Inquire About Bulk Orders</a> -->
            </div>
            <div class="calendar-container">
                <h3>Season Schedule 2026</h3>
                <div class="legend">
                    <span class="tag green">9:00 AM - 4:30 PM</span>
                    <span class="tag blue">10:00 AM - 4:30 PM</span>
                </div>

                <div class="month">
                    <div class="month-header">November 2026</div>
                    <div class="days-grid">
                        <!-- Weekday Headers -->
                        <span>Su</span><span>Mo</span><span>Tu</span><span
                            >We</span
                        ><span>Th</span><span>Fr</span><span>Sa</span>

                        <!-- Day Cells (Example for late Nov) -->
                        <div class="empty"></div><div class="empty"></div><div
                            class="empty"
                        >
                        </div>
                        <div class="empty"></div><div class="empty"></div><div
                            class="empty"
                        >
                        </div><span>1</span>
                        <!-- ... skip to the green days seen in image_bd6228.png ... -->
                        <span>22</span><span>23</span><span>24</span><span
                            >25</span
                        ><span>26</span>
                        <span class="green-day">27</span><span class="green-day"
                            >28</span
                        >
                        <span class="blue-day">29</span><span class="empty"
                        ></span>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .background-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background-color: var(--pine-dark);
    }
    .bg-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.3;
    }

    .content-container {
        display: flex;
        justify-content: center;
        padding: 120px 20px 60px;
    }

    .glass-box {
        max-width: 1000px;
        width: 100%;
        background: rgba(26, 46, 26, 0.8);
        backdrop-filter: blur(10px);
        padding: 3rem;
        border-radius: 8px;
        border: 1px solid var(--pine-accent);
        color: var(--cream);
    }

    h1 {
        border-bottom: 2px solid var(--pine-accent);
        padding-bottom: 10px;
    }

    .tree-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin: 2rem 0;
    }

    .tree-card {
        background: rgba(255, 255, 255, 0.05);
        padding: 1.5rem;
        border-radius: 4px;
        border-left: 4px solid var(--pine-accent);
    }

    .cta-section {
        margin-top: 3rem;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 2rem;
    }

    .cta-button {
        display: inline-block;
        background: var(--pine-accent);
        color: white;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
        margin-top: 1rem;
    }

    <style>
  .calendar-container {
    margin-top: 2rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 1.5rem;
    border-radius: 8px;
  }

  .legend {
    display: flex;
    gap: 10px;
    margin-bottom: 1rem;
  }

  .tag {
    padding: 4px 8px;
    font-size: 0.8rem;
    color: white;
    border-radius: 3px;
  }

  .green { background-color: #109661; } /* Matches image_bd6228.png */
  .blue { background-color: #6a6aff; }

  .month-header {
    background: #8b3a2b; /* Matches that brick-red in your screenshot */
    color: white;
    text-align: center;
    padding: 5px;
    font-weight: bold;
  }

  .days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    background: white; /* Keeps the high contrast from the original */
    color: #333;
  }

  .days-grid span, .days-grid div {
    padding: 10px;
    border: 1px solid #ddd;
    font-weight: bold;
  }

  .green-day { background-color: #109661; color: white; }
  .blue-day { background-color: #6a6aff; color: white; }
  .empty { background-color: #eee; }
</style>
