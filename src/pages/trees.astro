---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Calendar from "../components/Calendar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Our Trees - Ben's Christmas Tree Farm">
    <Navigation />



    <main class="content-container">
        <div class="glass-box">
            <h1>Our Tree Varieties</h1>
            <p class="intro-text">
                We specialize in 8 varieties of trees, carefully cultivated on
                our 100-acre farm in Harvard, IL. Each variety is hand-pruned to
                ensure the perfect shape. Here are our featured varieties, available up to 12+ feet tall:
            </p>

            <div class="tree-grid">
                <div class="tree-card">
                    <h3>Fraser Fir</h3>
                    <p>Known as the "King of Trees," Fraser Firs offer excellent needle retention and a pleasant scent.</p>
                </div>
                <div class="tree-card">
                    <h3>Norway Spruce</h3>
                    <p>Prized for its full, dense branches and unmistakable aroma, widely considered the original Christmas Tree.</p>
                </div>

                <div class="tree-card">
                    <h3>Canaan Fir</h3>
                    <p>A beautiful hybrid that combines the longevity and beauty of a fir with rich evergreen fragrance. </p>
                </div>


            </div>

            <div class="complete-list-section">
                <h3>Complete list of varieties:</h3>
                <ul class="variety-list">
                    <li>Fraser Fir</li>
                    <li>Canaan Fir</li>
                    <li>Balsam Fir</li>
                    <li>Concolor Fir</li>
                    <li>Norway Spruce</li>
                    <li>Blue Spruce</li>
                    <li>Scotch Pine</li>
                    <li>White Pine</li>
                </ul>
            </div>
            <Calendar />

            <div class="cta-section">
                <p>Our trees are certified naturally grown!</p>
            </div>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    /* GLOBAL LAYOUT STYLES */

    
    .bg-image {
        width: 100%; height: 100%; object-fit: cover;
        opacity: 0.3;
    }

    .content-container {
        display: flex;
        justify-content: center;
        padding: 120px 20px 60px;
    }

    .glass-box {
        max-width: 1000px;
        width: 100%;
        background: var(--glass-surface); /* UPDATED: Matches the dashboard tint universally */
        backdrop-filter: blur(10px);
        border-radius: 8px;
        border: 1px solid var(--glass-border); /* UPDATED: Uses unified fine borders */
        color: var(--cream);
        box-sizing: border-box;
        
        /* ADAPTIVE PADDING: Soft 1rem sides on mobile so grid lists don't look squeezed */
        padding: 2rem 1rem; 
    }

    /* HARDWARE BREAKPOINT: Locks back to your full layout breathing room on desktop monitors */
    @media (min-width: 768px) {
        .glass-box {
            padding: 3rem;
        }
    }

    h1 { border-bottom: 2px solid var(--pine-accent); padding-bottom: 10px; font-family: Georgia, serif; }

    /* TREE GRID STYLES */
    .tree-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin: 2rem 0;
    }

    .tree-card {
        background: rgba(255, 255, 255, 0.05);
        padding: 1.5rem;
        border-radius: 4px;
        border-left: 4px solid var(--pine-accent);
    }

    .tree-card h3 { color: var(--cream); margin-bottom: 0.5rem; }

    /* COMPLETE LIST STYLES */
    .complete-list-section {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .complete-list-section h3 {
        font-family: Georgia, serif;
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }

    .variety-list {
        list-style-type: '✓ ';
        padding-left: 1rem;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.5rem 2rem; 
    }

    .variety-list li { font-size: 1.05rem; opacity: 0.95; }

    /* REFACTORED CALENDAR STYLES */
    .calendar-section {
        margin-top: 3.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .calendar-section h2 { font-family: Georgia, serif; margin-bottom: 1.5rem; }
    
    .price-info { line-height: 1.6; margin-bottom: 1.5rem; font-size: 1.05rem; }
    .organic-note { font-style: italic; color: #a3cea0; }

    .legend { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 2rem; }
    .legend-item { display: flex; align-items: center; gap: 0.75rem; }
    
    .color-box { display: inline-block; width: 3.5rem; height: 1.25rem; border-radius: 2px; }
    .green-box, .open-green { background-color: #109661 !important; color: white !important; font-weight: bold; }
    .blue-box, .open-blue { background-color: #6a6aff !important; color: white !important; font-weight: bold; }
    .santa-note { font-size: 0.95rem; opacity: 0.85; margin-top: 0.25rem; }

    .calendar-flex-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2.5rem;
    }

    .month-card {
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 6px;
        overflow: hidden;
    }

    .month-title {
        background-color: #8b3a2b;
        color: white;
        text-align: center;
        padding: 0.8rem;
        font-weight: bold;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
    }

    /* New solid-grid trick for perfect borders */
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 1px; /* Creates the border lines */
        background: #e2e8f0; /* Color of the borders */
        border: 1px solid #e2e8f0; /* Outer border */
    }

    .calendar-grid div {
        background: #ffffff; /* Cell background */
        color: #222222;
        padding: 0.75rem 0;
        text-align: center;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .calendar-grid .day-label {
        background: #f8fafc;
        color: #4a5568;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .calendar-grid .pad { background: #f1f5f9; }

    .cta-section {
        margin-top: 3rem;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 2rem;
        font-weight: bold;
        font-size: 1.1rem;
    }
</style>