---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Calendar from "../components/Calendar.astro";
---

<Layout title="Ben's Christmas Tree Farm | Cut Your Own | Harvard, IL">
    <Navigation />

    <div class="split-hero-container">
        
        <div class="hero-image-side">
            <video 
                autoplay 
                muted 
                loop 
                playsinline 
                poster="/DJI_0850sm.jpg" 
                class="split-bg"
            >
                <source src="/nw_field_elevator.mp4" type="video/mp4" />
                <img src="/DJI_0850sm.jpg" alt="Ben's Christmas Tree Farm drone shot" class="split-bg" />
            </video>
            
            <div class="image-overlay-text mobile-hide">
                <h2>Ben's Christmas Tree Farm</h2>
                <p>Certified Naturally Grown Fraser Firs. Opening the day after Thanksgiving.</p>
            </div>
        </div>

        <div class="hero-dash-side">
            <div class="dash-scroll-wrapper">
                
                <header class="dash-header">
                    <h1 class="desktop-hide">Ben's Christmas Tree Farm</h1>
                    <h2 class="status-tag">The only Certified Naturally Grown Christmas tree farm in the Midwest!</h2>
                    <p class="status-tag">Soft Opening Weekend November 21-22, 2026</p>
                    <p class="status-tag">Grand Opening November 27, 2026</p>
                </header>

                <section class="dash-section" id="announcement-section">
                    <!-- Static Fallback HTML (preserves current content & SEO while dynamic fetch loads) -->
                    <h3 id="announcement-heading">2026 Season Announcement</h3>
                    <p id="announcement-body">
                        New for 2026 - "First Cut Weekend" (soft opening) on November 21-22! All of our trees,
                        including over 10,000 Fraser Firs, are 
                        <strong>100% herbicide and pesticide-free</strong>. We provide the saws, the twine, 
                        and free wagon rides into the fields—you just bring the family and dress for the weather.
                    </p>
                </section>

                <script>
                    const GIST_URL = "https://gist.githubusercontent.com/benstreefarm/80a3167982e5d7b1146f5b3a67cb2200/raw/announcement.json";

                    async function fetchAnnouncement() {
                        try {
                            // Append timestamp parameter to bypass aggressive browser caching
                            const res = await fetch(`${GIST_URL}?t=${Date.now()}`);
                            if (!res.ok) return;

                            const data = await res.json();
                            const headingEl = document.getElementById("announcement-heading");
                            const bodyEl = document.getElementById("announcement-body");

                            if (data.heading && headingEl) {
                                headingEl.textContent = data.heading;
                            }
                            if (data.message && bodyEl) {
                                // innerHTML allows bolding/links if included in your Gist string
                                bodyEl.innerHTML = data.message;
                            }
                        } catch (err) {
                            console.warn("Could not fetch live announcement, using static fallback:", err);
                        }
                    }

                    fetchAnnouncement();
                </script>

                <section class="dash-section pricing-node">
                    <h3>Harvest Pricing</h3>
                    <ul class="bullet-prices">
                        <li><strong>Firs & Spruces:</strong> Starting at $98 <span class="spec">($15/ft, 6.5' min)</span></li>
                        <li><strong>Pines:</strong> Starting at $52 <span class="spec">($8/ft, 6.5' min)</span></li>
                    </ul>
                    <p class="meta-text">We accept cash, checks, and credit cards.</p>
                    
                    <div class="cta-button-row">
                        <a href="/visit" class="btn-link primary">Directions & Map</a>
                        <a href="/trees" class="btn-link secondary">All 8 Varieties</a>
                    </div>
                </section>

                <Calendar />

            </div>
        </div>
    </div>
</Layout>

<style>
    /* RESET BODY FOR FULL-SCREEN DESIGN */
    :global(body) {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        background-color: var(--pine-dark);
    }

    /* SPLIT SYSTEM MATRIX */
    .split-hero-container {
        display: grid;
        grid-template-columns: 1fr;
        /* FIXED: Accounts for navbar height cleanly, zero gap */
        min-height: calc(100vh - 80px);
        width: 100vw;
        padding-top: 0; 
        margin-top: 0;
        box-sizing: border-box;
    }

    /* LEFT SIDE CONFIGS */
    .hero-image-side {
        position: relative;
        width: 100%;
        height: 40vh; /* Takes up a compact top window on mobile viewports */
        overflow: hidden;
        margin-top: 0; /* FIXED */
    }

    .split-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .image-overlay-text {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        padding: 2rem 1.5rem;
        background: linear-gradient(transparent, rgba(13, 26, 13, 0.5));
    }
    .image-overlay-text h2 { font-family: Georgia, serif; font-size: 1.8rem; color: #fff; margin: 0; }
    .image-overlay-text p { font-size: 1rem; color: #a3cea0; margin: 0.5rem 0 0; }

    /* RIGHT SIDE CONFIGS (THE BLURRED DASHBOARD) */
    .hero-dash-side {
        /* Swap the hardcoded 0.92 color for your unified design system token */
        background: var(--glass-surface); 
        backdrop-filter: blur(12px); 

        color: #f4efe6;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        margin-top: 0;
    }

    .dash-scroll-wrapper {
        padding: 2rem 1.5rem;
    }

    .dash-header { margin-bottom: 1.5rem; }
    /* FIXED: Prevent heading top-margin from pushing the container down */
    .dash-header h1 { font-family: Georgia, serif; font-size: 2rem; margin: 0; color: #ffffff; }
    .status-tag { color: #a3cea0; font-weight: bold; font-size: 1.05rem; margin-top: 0.25rem; }

    .dash-section { margin-bottom: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 1.25rem; }
    .dash-section h3 { font-family: Georgia, serif; font-size: 1.25rem; color: #fff; margin: 0 0 0.75rem; }
    .dash-section p { line-height: 1.5; font-size: 0.95rem; opacity: 0.9; margin: 0 0 0.5rem; }

    /* PRICING ELEMENTS */
    .bullet-prices { list-style: none; padding: 0; margin: 0 0 1rem; }
    .bullet-prices li { font-size: 1.1rem; padding: 0.4rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.03); }
    .bullet-prices .spec { font-size: 0.9rem; color: #a3cea0; margin-left: 0.5rem; }
    .meta-text { font-size: 0.85rem; opacity: 0.7; font-style: italic; }

    /* CTAs */
    .cta-button-row { display: flex; gap: 1rem; margin-top: 1.25rem; }
    .btn-link {
        text-decoration: none; font-weight: bold; font-size: 0.95rem;
        padding: 0.7rem 1.2rem; border-radius: 4px; text-align: center; flex: 1;
        transition: all 0.2s ease;
    }
    .btn-link.primary { background: #109661; color: white; }
    .btn-link.primary:hover { background: #15b374; }
    .btn-link.secondary { border: 1px solid rgba(255, 255, 255, 0.15); color: #f4efe6; }
    .btn-link.secondary:hover { background: rgba(255, 255, 255, 0.03); }

    /* COMPACT GRID CONFIGS */
    .mini-legend { display: flex; gap: 1.25rem; margin-bottom: 1rem; font-size: 0.85rem; }
    .dot { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; vertical-align: middle; }
    .dot.green, .g { background: #109661 !important; color: white; font-weight: bold; }
    .dot.blue, .b { background: #6a6aff !important; color: white; font-weight: bold; }

    .mini-months-row { display: flex; flex-direction: column; gap: 1.25rem; }
    .m-box { border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 4px; overflow: hidden; width: 100%; }
    .m-title { background: #8b3a2b; text-align: center; font-weight: bold; padding: 0.3rem; font-size: 0.9rem; color: #fff; }
    
    .m-grid { display: grid; grid-template-columns: repeat(7, 1fr); background: white; color: #222; text-align: center; font-size: 0.8rem; }
    .m-grid div { padding: 0.35rem 0; border-bottom: 1px solid #f0f0f0; border-right: 1px solid #f0f0f0; }
    .m-grid .l { background: #f1f5f9; color: #64748b; font-weight: bold; font-size: 0.7rem; }
    .m-grid .e { background: #f8fafc; }
    .santa-footer { font-size: 0.85rem; font-style: italic; opacity: 0.8; margin-top: 0.75rem; color: #fecaca; }

    /* RESPONSIVE VISIBILITY SWITCHES */
    .mobile-hide {
        display: none !important;
    }
    
    .desktop-hide {
        display: block;
        margin-bottom: 0.5rem;
    }

    /* HARDWARE BREAKPOINT: Activates split-pane on standard monitors */
    @media (min-width: 950px) {
        .split-hero-container {
            grid-template-columns: 45vw 55vw;
            /* FIXED: Locks layout below navbar height bounds cleanly on desktop */
            /* height: calc(100vh - 80px);
            min-height: calc(100vh - 80px);
            height: calc(100vh - 64px); */
            min-height: calc(100vh - 64px);
            overflow: hidden;
        }

        .mobile-hide {
            display: block !important;
        }

        .desktop-hide {
            display: none !important;
        }

        .hero-image-side {
            height: 100%; /* Spans full height of screen */
        }

        .image-overlay-text {
            padding: 3rem;
            background: linear-gradient(transparent, rgba(13, 26, 13, 0.2));
        }
        .image-overlay-text h2 { font-size: 2.5rem; }
        .image-overlay-text p { font-size: 1.2rem; }

        .hero-dash-side {
            height: 100%;
            overflow-y: auto; /* Adds a clean independent scroll bar to the text dashboard side only */
            border-top: none;
            border-left: 1px solid rgba(255, 255, 255, 0.05);
            
            /* ADD THESE TWO LINES */
            /*background: var(--glass-surface); 
            backdrop-filter: blur(12px); */
            background-color: rgba(14, 26, 14, 0.15) !important; 
            backdrop-filter: blur(12px) !important;
        }

        .dash-scroll-wrapper {
            padding: 3rem;
        }

        .mini-months-row {
            flex-direction: row; /* Puts November and December side-by-side on desktop */
            gap: 1.5rem;
        }
    }

    /* Keep the main mobile dashboard header text visible and fluid */
    .desktop-hide {
        display: block;
        font-size: clamp(1.4rem, 5.5vw, 2rem) !important; /* Dynamically scales the home card title */
        white-space: nowrap;
        margin-bottom: 0.5rem;
    }
</style>