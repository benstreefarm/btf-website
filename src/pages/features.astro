---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Farm Features & Amenities | Ben's Christmas Tree Farm">
    <Navigation />

    <main class="content-container">
        <div class="glass-dashboard">
            
            <header class="features-header">
                <h1>Farm Features & Amenities</h1>
                <p class="subtitle">Everything included with your family's visit to the farm</p>
            </header>

            <!-- FEATURE 1: Text Left, Image Right on Desktop / Image First on Mobile -->
            <section class="story-row">
                <div class="text-block">
                    <h2>Complimentary Horse-Drawn Wagon Rides</h2>
                    <p>
                        Go back in time as you enjoy this simple pleasure of a bygone era with your family. 
                        Hop aboard for a scenic ride out into the fields and back.
                    </p>
                </div>
                <div class="image-block frame-cozy rotate-right">
                    <img src="/feature_wagon_new.jpg" alt="Complimentary horse-drawn wagon rides at Ben's Christmas Tree Farm" />
                    <p class="caption">Horse-drawn wagon rides</p>
                </div>
            </section>

            <!-- FEATURE 2: Image Left, Text Right on Desktop / Image First on Mobile -->
            <section class="story-row reverse">
                <div class="image-block frame-cozy rotate-left">
                    <img src="/feature_cocoa.jpg" alt="Kid enjoying hot cocoa in the Warming Barn" />
                    <p class="caption">Hot chocolate mustaches for everyone!</p>
                </div>
                <div class="text-block">
                    <h2>Coffee & Hot Cocoa</h2>
                    <p>
                        Hot chocolate mustaches for everyone! After you have found that perfect tree, 
                        come in and enjoy a warm cup of coffee or hot chocolate in our Warming Barn.
                    </p>
                </div>
            </section>

            <!-- FEATURE 3: Text Left, Image Right on Desktop / Image First on Mobile -->
            <section class="story-row">
                <div class="text-block">
                    <h2>Farm Animals</h2>
                    <p>
                        Take some time to visit our farm animals at no charge—your kids will love you for it. 
                        This year we will have a goat, a pig, a bunny, and some ducks!
                    </p>
                </div>
                <div class="image-block frame-cozy rotate-right">
                    <img src="/feature_animals.jpg" alt="Friendly farm animals to visit" />
                    <p class="caption">Visit our friendly farm animals</p>
                </div>
            </section>

            <!-- FEATURE 4: Image Left, Text Right on Desktop / Image First on Mobile -->
            <section class="story-row reverse">
                <div class="image-block frame-cozy rotate-left">
                    <img src="/feature_wreaths.jpg" alt="Hand-made fresh Fraser Fir wreaths and garland" />
                    <p class="caption">Fresh, hand-made Fraser Fir wreaths</p>
                </div>
                <div class="text-block">
                    <h2>Hand-Made Fraser Fir Wreaths & Garland</h2>
                    <p>
                        You'll love Ben's fresh, hand-made wreaths and greens items. We offer fully decorated 
                        as well as decorate-your-own wreaths made from fresh cultivated Fraser Fir—we can even 
                        custom-decorate your wreath on the spot!
                    </p>
                    <p>
                        Cultivated fir offers a richer, deeper green and provides the traditional, wonderful 
                        fragrance of Christmas.
                    </p>
                </div>
            </section>

            <!-- FEATURE 5: Text Left, Image Right on Desktop / Image First on Mobile -->
            <section class="story-row">
                <div class="text-block">
                    <h2>Pet Friendly!</h2>
                    <p>
                        Come one, come all—bring Rover! Leashed pets are welcome across the farm. 
                        (Dog sleds are optional.)
                    </p>
                </div>
                <div class="image-block frame-cozy rotate-right">
                    <img src="/feature_pets.jpg" alt="Leashed dogs walking through the snowy tree rows" />
                    <p class="caption">Leashed pets are always welcome</p>
                </div>
            </section>

            <!-- FEATURE 6: Image Left, Text Right on Desktop / Image First on Mobile -->
            <section class="story-row reverse">
                <div class="image-block frame-cozy rotate-left">
                    <img src="/feature_baling.jpg" alt="Staff shaking and baling a fresh Christmas tree" />
                    <p class="caption">Free tree shaking and baling</p>
                </div>
                <div class="text-block">
                    <h2>Free Shaking & Baling of Trees</h2>
                    <p>
                        For your comfort and ease, each tree is shaken to remove loose needles and neatly baled 
                        by our attentive staff so it's easy to load and bring home.
                    </p>
                </div>
            </section>

            <!-- FEATURE 7: Text Left, Image Right on Desktop / Image First on Mobile -->
            <section class="story-row last-row">
                <div class="text-block">
                    <h2>Pictures with Santa</h2>
                    <p>
                        Free photo-ops with Santa—don't forget to tell him your wish list!
                    </p>
                </div>
                <div class="image-block frame-cozy rotate-right">
                    <img src="/feature_santa.jpg" alt="Family smiling with Santa at Ben's Christmas Tree Farm" />
                    <p class="caption">Free photo-ops with Santa</p>
                </div>
            </section>

        </div>
    </main>
    <Footer />
</Layout>

<style>
    .content-container {
        display: flex;
        justify-content: center;
        padding: 120px 20px 60px;
    }

    .features-header {
        border-bottom: 2px solid #109661;
        padding-bottom: 1.5rem;
        margin-bottom: 3rem;
        text-align: center;
    }
    .features-header h1 {
        font-family: Georgia, serif;
        font-size: 2.5rem;
        margin: 0;
        color: #ffffff;
    }
    .subtitle {
        font-style: italic;
        color: #a3cea0;
        font-size: 1.1rem;
        margin-top: 0.5rem;
    }

    /* MOBILE EDITORIAL SYSTEM */
    .story-row {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-bottom: 4rem;
    }
    .story-row.last-row {
        margin-bottom: 1rem;
    }

    /* IMAGE FIRST ON MOBILE */
    .story-row .image-block {
        order: 1;
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
    }
    .story-row .text-block {
        order: 2;
    }

    .text-block h2 {
        font-family: Georgia, serif;
        font-size: 1.75rem;
        margin-top: 0;
        color: #ffffff;
    }
    .text-block p {
        line-height: 1.7;
        font-size: 1.05rem;
        opacity: 0.95;
        margin-bottom: 1.25rem;
    }

    /* COZY SCRAPBOOK PHOTO FRAME */
    .frame-cozy {
        background: #ffffff;
        padding: 0.75rem 0.75rem 2rem;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5), 0 2px 4px rgba(0, 0, 0, 0.2);
        border-radius: 2px;
        transition: transform 0.3s ease-in-out;
        box-sizing: border-box;
    }
    .frame-cozy img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
        border-radius: 1px;
        background-color: #e2e8f0;
        min-height: 200px;
    }
    .frame-cozy .caption {
        font-family: "Permanent Marker", "Courier New", cursive, serif;
        color: #2b3e2b;
        text-align: center;
        font-size: 0.95rem;
        margin: 0.75rem 0 0;
        font-weight: bold;
    }

    .rotate-right { transform: rotate(1.5deg); }
    .rotate-left { transform: rotate(-1.5deg); }
    .frame-cozy:hover { transform: rotate(0deg) scale(1.02); }

    /* DESKTOP SIDE-BY-SIDE GRID */
    @media (min-width: 768px) {
        .story-row {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 3.5rem;
            align-items: center;
        }
        
        .story-row.reverse {
            grid-template-columns: 0.8fr 1.2fr;
        }

        .story-row .image-block { order: unset; }
        .story-row .text-block { order: unset; }

        .image-block.frame-cozy {
            width: 100%;
            max-width: 340px;
            margin: 0 auto;
        }

        .image-block.frame-cozy img {
            width: 100%;
            height: auto;
            max-height: 360px;
            object-fit: cover;
            display: block;
        }
    }
</style>